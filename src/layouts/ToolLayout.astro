---
import BaseLayout from './BaseLayout.astro';
import SEO from '../components/SEO.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WebApplicationSchema from '../components/WebApplicationSchema.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Adsense from '../components/Adsense.astro';
import { getRelatedTools } from '../data/tools';
import { toolDescriptions } from '../data/toolDescriptions';
import type { BreadcrumbItem } from '../components/Breadcrumb.astro';

export interface Props {
  title: string;
  description: string;
  toolId: string;
  category: string;
  categoryLabel: string;
}

const { title, description, toolId, category, categoryLabel } = Astro.props;

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: categoryLabel, href: `/tools/${category}` },
  { label: title },
];

const relatedTools = getRelatedTools(toolId);
const toolDesc = toolDescriptions[toolId];
---

<BaseLayout title={`${title} - Free Online Tool | FreeQuickUtility`} description={description}>
  <Fragment slot="head">
    <SEO title={`${title} - Free Online Tool | FreeQuickUtility`} description={description} canonical={`/tools/${toolId}`} />
    <WebApplicationSchema name={title} description={description} url={`/tools/${toolId}`} category="Utility" />
  </Fragment>

  <div class="mx-auto max-w-4xl px-4 py-8 md:px-6 md:py-12">
    <Breadcrumb items={breadcrumbs} />

    <div class="mb-8">
      <h1 class="text-2xl font-semibold tracking-tight text-[var(--color-ink)] md:text-3xl" style="letter-spacing: -1.28px;">
        {title}
      </h1>
      <p class="mt-2 text-base text-[var(--color-body)]">{description}</p>
    </div>

    <!-- Tool Content -->
    <div class="rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-6 shadow-[0px_1px_1px_rgba(0,0,0,0.02),0px_2px_2px_rgba(0,0,0,0.04)]">
      <slot />
    </div>

    <!-- FAQ Section -->
    <slot name="faq" />

    <Adsense slotKey="toolFooter" />

    <!-- Detailed Description Section for SEO -->
    {toolDesc && (
      <section class="mt-12 border-t border-[var(--color-hairline)] pt-10">
        <h2 class="text-xl font-semibold tracking-tight text-[var(--color-ink)] md:text-2xl" style="letter-spacing: -0.6px;">
          {toolDesc.title}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-[var(--color-body)]">
          {toolDesc.content}
        </p>

        <h3 class="mt-8 text-lg font-medium text-[var(--color-ink)]">How to Use This Tool</h3>
        <ol class="mt-3 list-inside list-decimal space-y-2 text-sm leading-relaxed text-[var(--color-body)]">
          {toolDesc.howToUse.map((step) => (
            <li>{step}</li>
          ))}
        </ol>

        <h3 class="mt-8 text-lg font-medium text-[var(--color-ink)]">Key Features</h3>
        <ul class="mt-3 list-inside list-disc space-y-2 text-sm leading-relaxed text-[var(--color-body)]">
          {toolDesc.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      </section>
    )}

    <!-- Related Tools -->
    <RelatedTools tools={relatedTools} />
  </div>
</BaseLayout>
