---
import { ADSENSE_CLIENT, getAdSlot, type AdSlotKey } from '../config/ads';

export interface Props {
  slotKey: AdSlotKey;
  format?: 'auto' | 'rectangle' | 'horizontal' | 'vertical' | 'fluid';
  label?: string;
}

const { slotKey, format = 'auto', label = 'Advertisement' } = Astro.props;
const slot = getAdSlot(slotKey);
---

{slot && (
  <aside class="my-8" aria-label="Advertisement">
    <p class="mb-2 text-center text-[10px] uppercase tracking-wide text-[var(--color-mute)]">{label}</p>
    <div class="flex min-h-[90px] items-center justify-center overflow-hidden rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)]">
      <ins
        class="adsbygoogle block w-full"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format={format}
        data-full-width-responsive="true"
      ></ins>
    </div>
  </aside>
)}

{slot && (
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
)}
