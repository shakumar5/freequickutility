---
import { searchTools } from '../data/searchTools';

const navLinks = [
  { label: 'Tools', href: '/#tools' },
  { label: 'Text Tools', href: '/tools/text-tools' },
  { label: 'Calculators', href: '/tools/calculators' },
  { label: 'Generators', href: '/tools/generators' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-4 md:px-6" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-[var(--color-ink)] no-underline">
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-[var(--color-primary)]">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 4L8 2L14 4L8 6L2 4Z" fill="white" />
          <path d="M2 4V10L8 12V6L2 4Z" fill="white" opacity="0.7" />
          <path d="M8 6V12L14 10V4L8 6Z" fill="white" opacity="0.5" />
        </svg>
      </span>
      <span class="text-sm font-semibold tracking-tight">FreeQuickUtility</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-full px-3 py-1.5 text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)] hover:text-[var(--color-ink)]"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Search + Mobile Menu -->
    <div class="flex items-center gap-2">
      <button
        id="search-trigger"
        class="flex h-8 items-center gap-2 rounded-md border border-[var(--color-hairline)] px-3 text-sm text-[var(--color-mute)] transition-colors hover:border-[var(--color-hairline-strong)] hover:text-[var(--color-body)]"
        aria-label="Search tools"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
        </svg>
        <span class="hidden sm:inline">Search...</span>
        <kbd class="hidden rounded bg-[var(--color-canvas-soft-2)] px-1.5 py-0.5 font-mono text-xs text-[var(--color-mute)] sm:inline">⌘K</kbd>
      </button>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-toggle"
        class="flex h-8 w-8 items-center justify-center rounded-md md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="hidden border-t border-[var(--color-hairline)] bg-[var(--color-canvas)] md:hidden">
    <div class="flex flex-col px-4 py-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-3 py-2 text-sm text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)] hover:text-[var(--color-ink)]"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<!-- Search Modal -->
<div id="search-modal" class="fixed inset-0 z-[100] hidden items-start justify-center bg-black/50 backdrop-blur-sm pt-[20vh]" role="dialog" aria-label="Search tools">
  <div class="mx-4 w-full max-w-lg overflow-hidden rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] shadow-2xl">
    <div class="flex items-center gap-3 border-b border-[var(--color-hairline)] px-4 py-3">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-mute)" stroke-width="2">
        <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search tools..."
        class="flex-1 bg-transparent text-sm text-[var(--color-ink)] outline-none placeholder:text-[var(--color-mute)]"
        autocomplete="off"
      />
      <kbd class="rounded bg-[var(--color-canvas-soft-2)] px-1.5 py-0.5 font-mono text-xs text-[var(--color-mute)]">ESC</kbd>
    </div>
    <div id="search-results" class="max-h-80 overflow-y-auto p-2">
      <p class="px-3 py-6 text-center text-sm text-[var(--color-mute)]">Type to search tools...</p>
    </div>
  </div>
</div>

<script define:vars={{ searchTools }}>
  // Mobile menu toggle
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileToggle?.addEventListener('click', () => {
    const expanded = mobileToggle.getAttribute('aria-expanded') === 'true';
    mobileToggle.setAttribute('aria-expanded', String(!expanded));
    mobileMenu?.classList.toggle('hidden');
  });

  // Search modal
  const searchTrigger = document.getElementById('search-trigger');
  const searchModal = document.getElementById('search-modal');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');

  function openSearch() {
    searchModal?.classList.remove('hidden');
    searchModal?.classList.add('flex');
    searchInput?.focus();
  }

  function closeSearch() {
    searchModal?.classList.add('hidden');
    searchModal?.classList.remove('flex');
    if (searchInput) searchInput.value = '';
    if (searchResults) searchResults.innerHTML = '<p class="px-3 py-6 text-center text-sm text-[var(--color-mute)]">Type to search tools...</p>';
  }

  searchTrigger?.addEventListener('click', openSearch);
  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearch();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') closeSearch();
  });

  // Search functionality
  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    if (!query) {
      if (searchResults) searchResults.innerHTML = '<p class="px-3 py-6 text-center text-sm text-[var(--color-mute)]">Type to search tools...</p>';
      return;
    }
    const filtered = searchTools.filter(
      (t) => t.name.toLowerCase().includes(query) || t.category.toLowerCase().includes(query)
    );
    if (filtered.length === 0) {
      if (searchResults) searchResults.innerHTML = '<p class="px-3 py-6 text-center text-sm text-[var(--color-mute)]">No tools found.</p>';
      return;
    }
    if (searchResults) {
      searchResults.innerHTML = filtered
        .map(
          (t) => `<a href="${t.path}" class="flex items-center gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-[var(--color-canvas-soft-2)]">
            <span class="text-lg">${t.icon}</span>
            <div class="flex-1">
              <p class="text-sm font-medium text-[var(--color-ink)]">${t.name}</p>
              <p class="text-xs text-[var(--color-mute)]">${t.category}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-mute)" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </a>`
        )
        .join('');
    }
  });
</script>
