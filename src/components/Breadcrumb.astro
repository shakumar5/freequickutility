---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href && {
      item: item.href === '/'
        ? 'https://freequickutility.com/'
        : `https://freequickutility.com${item.href.endsWith('/') ? item.href : item.href + '/'}`,
    }),
  })),
};
---

<nav aria-label="Breadcrumb" class="mb-4">
  <ol class="flex flex-wrap items-center gap-1 text-sm">
    {items.map((item, index) => (
      <li class="flex items-center gap-1">
        {index > 0 && (
          <svg class="h-3 w-3 text-[var(--color-mute)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        )}
        {item.href ? (
          <a href={item.href} class="text-[var(--color-body)] transition-colors hover:text-[var(--color-ink)]">
            {item.label}
          </a>
        ) : (
          <span class="text-[var(--color-ink)] font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
