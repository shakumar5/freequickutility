---
import type { FAQ } from '../data/faqs';

export interface Props {
  faqs: FAQ[];
  title?: string;
}

const { faqs, title = 'Frequently asked questions.' } = Astro.props;
---

<section class="mx-auto max-w-[1400px] px-4 py-16 md:px-6">
  <div class="mx-auto max-w-2xl">
    <div class="mb-8 text-center">
      <p class="mb-2 font-mono text-xs uppercase tracking-wide text-[var(--color-mute)]">FAQ</p>
      <h2 class="text-2xl font-semibold tracking-tight text-[var(--color-ink)] md:text-3xl" style="letter-spacing: -1.28px;">
        {title}
      </h2>
    </div>
    <div class="divide-y divide-[var(--color-hairline)]">
      {faqs.map((faq) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-medium text-[var(--color-ink)] [&::-webkit-details-marker]:hidden">
            {faq.question}
            <svg
              class="h-4 w-4 shrink-0 text-[var(--color-mute)] transition-transform group-open:rotate-45"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-body)]">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
