---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
---

<BaseLayout title="Blog - FreeQuickUtility" description="Tips, tutorials, and updates from FreeQuickUtility.">
  <Fragment slot="head">
    <SEO title="Blog - FreeQuickUtility" description="Tips, tutorials, and guides for using online utility tools effectively." canonical="/blog" />
  </Fragment>

  <div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-20">
    <h1 class="text-3xl font-semibold tracking-tight text-[var(--color-ink)] md:text-4xl" style="letter-spacing: -1.28px;">Blog</h1>
    <p class="mt-3 text-base text-[var(--color-body)]">Tips, tutorials, and updates about our tools.</p>

    <div class="mt-12 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-8 text-center">
      <p class="text-4xl">✍️</p>
      <h2 class="mt-4 text-lg font-medium text-[var(--color-ink)]">Coming soon</h2>
      <p class="mt-2 text-sm text-[var(--color-body)]">
        We're working on helpful articles about productivity, tool tips, and best practices.
        Check back soon!
      </p>
    </div>
  </div>
</BaseLayout>
