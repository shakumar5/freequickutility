---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout title="Blog - FreeQuickUtility" description="Tips, tutorials, and guides about online tools, finance, security, and productivity.">
  <Fragment slot="head">
    <SEO title="Blog - Tips, Tutorials & Guides | FreeQuickUtility" description="Learn about EMI calculation, SIP investing, password security, social media tips, and more. Practical guides with free tools." canonical="/blog" />
  </Fragment>

  <div class="mx-auto max-w-4xl px-4 py-12 md:px-6 md:py-20">
    <div class="mb-10">
      <p class="mb-2 font-mono text-xs uppercase tracking-wide text-[var(--color-mute)]">Blog</p>
      <h1 class="text-3xl font-semibold tracking-tight text-[var(--color-ink)] md:text-4xl" style="letter-spacing: -1.28px;">Tips, guides & tutorials.</h1>
      <p class="mt-3 text-base text-[var(--color-body)]">Practical articles about finance, productivity, security, and getting the most out of our tools.</p>
    </div>

    <div class="space-y-6">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group block rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-6 transition-all duration-200 hover:border-[var(--color-hairline-strong)] hover:shadow-[0px_2px_2px_rgba(0,0,0,0.04),0px_8px_16px_-4px_rgba(0,0,0,0.04)]"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="mb-2 flex items-center gap-2">
                <span class="rounded-full bg-[var(--color-canvas-soft-2)] px-2.5 py-0.5 text-[10px] font-medium text-[var(--color-body)]">
                  {post.data.category}
                </span>
                <span class="text-xs text-[var(--color-mute)]">
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
              </div>
              <h2 class="text-lg font-medium text-[var(--color-ink)] group-hover:text-[var(--color-link)]" style="letter-spacing: -0.6px;">
                {post.data.title}
              </h2>
              <p class="mt-1.5 text-sm text-[var(--color-body)]">{post.data.description}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {post.data.tags.slice(0, 3).map((tag: string) => (
                  <span class="rounded-md bg-[var(--color-canvas-soft)] px-2 py-0.5 text-[11px] text-[var(--color-mute)]">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
            <svg class="mt-1 h-5 w-5 shrink-0 text-[var(--color-mute)] transition-transform group-hover:translate-x-0.5 group-hover:text-[var(--color-link)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
