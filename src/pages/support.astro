---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
---

<BaseLayout title="Support Us - FreeQuickUtility" description="Help us keep FreeQuickUtility free and ad-light. Your support helps us build better tools.">
  <Fragment slot="head">
    <SEO title="Support Us - FreeQuickUtility" description="FreeQuickUtility is free for everyone. If our tools have saved you time, consider buying us a coffee to keep the project going." canonical="/support" />
  </Fragment>

  <div class="mx-auto max-w-2xl px-4 py-12 md:px-6 md:py-20">
    <!-- Hero -->
    <div class="text-center">
      <span class="text-5xl">☕</span>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--color-ink)] md:text-4xl" style="letter-spacing: -1.28px;">
        Support FreeQuickUtility.
      </h1>
      <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-[var(--color-body)]">
        We believe useful tools should be free for everyone — no paywalls, no forced sign-ups, no data harvesting. If our tools have saved you time or made your day easier, consider supporting us.
      </p>
    </div>

    <!-- Support Card -->
    <div class="mt-10 rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-8 text-center shadow-[0px_2px_2px_rgba(0,0,0,0.04),0px_8px_16px_-4px_rgba(0,0,0,0.04)]">
      <p class="text-sm text-[var(--color-body)]">Every contribution helps us</p>
      <div class="mt-4 space-y-3">
        <div class="flex items-center gap-3 rounded-lg bg-[var(--color-canvas-soft)] p-3 text-left">
          <span class="text-lg">🛠️</span>
          <span class="text-sm text-[var(--color-ink)]">Build new tools and improve existing ones</span>
        </div>
        <div class="flex items-center gap-3 rounded-lg bg-[var(--color-canvas-soft)] p-3 text-left">
          <span class="text-lg">⚡</span>
          <span class="text-sm text-[var(--color-ink)]">Keep the site fast with zero-cost hosting upgrades</span>
        </div>
        <div class="flex items-center gap-3 rounded-lg bg-[var(--color-canvas-soft)] p-3 text-left">
          <span class="text-lg">🚫</span>
          <span class="text-sm text-[var(--color-ink)]">Reduce ads and keep the experience clean</span>
        </div>
        <div class="flex items-center gap-3 rounded-lg bg-[var(--color-canvas-soft)] p-3 text-left">
          <span class="text-lg">💚</span>
          <span class="text-sm text-[var(--color-ink)]">Keep everything free and accessible for everyone</span>
        </div>
      </div>

      <a
        href="https://razorpay.me/@freequickutility"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex h-12 items-center gap-2 rounded-full bg-[var(--color-primary)] px-8 text-base font-medium text-[var(--color-on-primary)] transition-opacity hover:opacity-90"
      >
        ☕ Buy Us a Coffee
      </a>
      <p class="mt-3 text-xs text-[var(--color-mute)]">Secure payment via Razorpay • Any amount appreciated</p>
    </div>

    <!-- Thank You Note -->
    <div class="mt-10 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] p-6 text-center">
      <p class="text-sm font-medium text-[var(--color-ink)]">Not in a position to donate? No worries!</p>
      <p class="mt-2 text-sm text-[var(--color-body)]">
        You can still help by sharing our tools with friends, leaving feedback, or simply spreading the word.
        Every share counts. 🙏
      </p>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        <a
          href="https://twitter.com/intent/tweet?text=Check%20out%20FreeQuickUtility%20-%20free%20online%20tools%20for%20everyday%20tasks!&url=https://freequickutility.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]"
        >
          𝕏 Share on Twitter
        </a>
        <a
          href="https://wa.me/?text=Check%20out%20FreeQuickUtility%20-%20free%20online%20tools%20for%20everyday%20tasks!%20https://freequickutility.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]"
        >
          💬 Share on WhatsApp
        </a>
        <a
          href="https://www.linkedin.com/sharing/share-offsite/?url=https://freequickutility.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]"
        >
          💼 Share on LinkedIn
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
