---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Something Went Wrong - FreeQuickUtility" description="An unexpected error occurred.">
  <div class="mx-auto flex max-w-2xl flex-col items-center justify-center px-4 py-24 text-center md:py-40">
    <!-- Large 500 -->
    <p class="text-8xl font-semibold tracking-tighter text-[var(--color-hairline)] md:text-9xl" style="letter-spacing: -4px;">500</p>

    <!-- Message -->
    <h1 class="mt-6 text-2xl font-semibold tracking-tight text-[var(--color-ink)] md:text-3xl" style="letter-spacing: -1.28px;">
      Something went wrong.
    </h1>
    <p class="mt-3 text-base text-[var(--color-body)]">
      An unexpected error occurred. Please try again or go back to the homepage.
    </p>

    <!-- Actions -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-10 items-center rounded-full bg-[var(--color-primary)] px-5 text-sm font-medium text-[var(--color-on-primary)] transition-opacity hover:opacity-90"
      >
        Go Home
      </a>
      <button
        onclick="window.location.reload()"
        class="inline-flex h-10 items-center rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] px-5 text-sm font-medium text-[var(--color-ink)] transition-colors hover:border-[var(--color-hairline-strong)]"
      >
        Try Again
      </button>
    </div>

    <!-- Status info -->
    <p class="mt-12 text-xs text-[var(--color-mute)]">
      If this keeps happening, please <a href="/contact" class="text-[var(--color-link)] hover:underline">contact us</a> and let us know.
    </p>
  </div>
</BaseLayout>
