---
import ToolLayout from '../../layouts/ToolLayout.astro';
import FAQ from '../../components/FAQ.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import { toolFaqs } from '../../data/toolFaqs';

const faqs = toolFaqs['password-generator'];
---

<ToolLayout
  title="Password Generator"
  description="Generate strong, secure passwords with customizable length, character sets, and strength indicator."
  toolId="password-generator"
  category="generators"
  categoryLabel="Generators"
>
  <div>
    <!-- Generated password display -->
    <div class="flex items-center gap-2 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] p-4">
      <code id="pw-output" class="flex-1 break-all font-mono text-lg text-[var(--color-ink)]">Click generate...</code>
      <button id="pw-copy" class="shrink-0 rounded-md border border-[var(--color-hairline)] px-3 py-1.5 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]" aria-label="Copy password">
        Copy
      </button>
    </div>

    <!-- Strength indicator -->
    <div class="mt-3 flex items-center gap-3">
      <div class="flex h-1.5 flex-1 gap-1">
        <div id="pw-str-1" class="h-full flex-1 rounded-full bg-[var(--color-hairline)]"></div>
        <div id="pw-str-2" class="h-full flex-1 rounded-full bg-[var(--color-hairline)]"></div>
        <div id="pw-str-3" class="h-full flex-1 rounded-full bg-[var(--color-hairline)]"></div>
        <div id="pw-str-4" class="h-full flex-1 rounded-full bg-[var(--color-hairline)]"></div>
      </div>
      <span id="pw-str-label" class="text-xs font-medium text-[var(--color-mute)]">-</span>
    </div>

    <!-- Options -->
    <div class="mt-6 space-y-4">
      <div>
        <label for="pw-length" class="mb-1.5 flex items-center justify-between text-xs font-medium text-[var(--color-body)]">
          <span>Length</span>
          <span id="pw-length-value" class="font-mono text-[var(--color-ink)]">16</span>
        </label>
        <input type="range" id="pw-length" min="4" max="64" value="16" class="w-full" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <label class="flex items-center gap-2 text-sm text-[var(--color-body)]">
          <input type="checkbox" id="pw-upper" checked class="rounded" /> Uppercase (A-Z)
        </label>
        <label class="flex items-center gap-2 text-sm text-[var(--color-body)]">
          <input type="checkbox" id="pw-lower" checked class="rounded" /> Lowercase (a-z)
        </label>
        <label class="flex items-center gap-2 text-sm text-[var(--color-body)]">
          <input type="checkbox" id="pw-numbers" checked class="rounded" /> Numbers (0-9)
        </label>
        <label class="flex items-center gap-2 text-sm text-[var(--color-body)]">
          <input type="checkbox" id="pw-symbols" checked class="rounded" /> Symbols (!@#$)
        </label>
        <label class="flex items-center gap-2 text-sm text-[var(--color-body)]">
          <input type="checkbox" id="pw-ambiguous" class="rounded" /> Exclude ambiguous (0OIl)
        </label>
      </div>
    </div>

    <button id="pw-generate" class="mt-6 rounded-full bg-[var(--color-primary)] px-5 py-2.5 text-sm font-medium text-[var(--color-on-primary)] transition-opacity hover:opacity-90">
      Generate Password
    </button>
  </div>
  <Fragment slot="faq">
    <FAQ faqs={faqs} title="Password Generator FAQ" />
    <FAQSchema faqs={faqs} />
  </Fragment>
</ToolLayout>

<script>
  const output = document.getElementById('pw-output')!;
  const lengthSlider = document.getElementById('pw-length') as HTMLInputElement;
  const lengthValue = document.getElementById('pw-length-value')!;
  const generateBtn = document.getElementById('pw-generate');
  const copyBtn = document.getElementById('pw-copy');

  lengthSlider.addEventListener('input', () => { lengthValue.textContent = lengthSlider.value; });

  function generate() {
    const length = parseInt(lengthSlider.value);
    const upper = (document.getElementById('pw-upper') as HTMLInputElement).checked;
    const lower = (document.getElementById('pw-lower') as HTMLInputElement).checked;
    const numbers = (document.getElementById('pw-numbers') as HTMLInputElement).checked;
    const symbols = (document.getElementById('pw-symbols') as HTMLInputElement).checked;
    const excludeAmbiguous = (document.getElementById('pw-ambiguous') as HTMLInputElement).checked;

    let chars = '';
    if (upper) chars += excludeAmbiguous ? 'ABCDEFGHJKLMNPQRSTUVWXYZ' : 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    if (lower) chars += excludeAmbiguous ? 'abcdefghjkmnpqrstuvwxyz' : 'abcdefghijklmnopqrstuvwxyz';
    if (numbers) chars += excludeAmbiguous ? '23456789' : '0123456789';
    if (symbols) chars += '!@#$%^&*()_+-=[]{}|;:,.<>?';
    if (!chars) chars = 'abcdefghijklmnopqrstuvwxyz';

    const array = new Uint32Array(length);
    crypto.getRandomValues(array);
    let password = '';
    for (let i = 0; i < length; i++) password += chars[array[i] % chars.length];

    output.textContent = password;
    updateStrength(password);
  }

  function updateStrength(pw: string) {
    let score = 0;
    if (pw.length >= 8) score++;
    if (pw.length >= 12) score++;
    if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) score++;
    if (/\d/.test(pw)) score++;
    if (/[^a-zA-Z0-9]/.test(pw)) score++;
    if (pw.length >= 16) score++;

    const colors = ['#ee0000', '#f5a623', '#0070f3', '#0cce6b'];
    const labels = ['Weak', 'Fair', 'Good', 'Strong'];
    const level = score <= 2 ? 0 : score <= 3 ? 1 : score <= 4 ? 2 : 3;

    for (let i = 1; i <= 4; i++) {
      const bar = document.getElementById(`pw-str-${i}`)!;
      bar.style.backgroundColor = i <= level + 1 ? colors[level] : 'var(--color-hairline)';
    }
    const label = document.getElementById('pw-str-label')!;
    label.textContent = labels[level];
    label.style.color = colors[level];
  }

  generateBtn?.addEventListener('click', generate);
  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(output.textContent || '');
    copyBtn.textContent = 'Copied!';
    setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
  });

  generate(); // Generate one on load
</script>
