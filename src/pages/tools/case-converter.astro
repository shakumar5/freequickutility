---
import ToolLayout from '../../layouts/ToolLayout.astro';
import FAQ from '../../components/FAQ.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import { toolFaqs } from '../../data/toolFaqs';

const faqs = toolFaqs['case-converter'];
---

<ToolLayout
  title="Case Converter"
  description="Convert text between uppercase, lowercase, title case, sentence case, camelCase, and more."
  toolId="case-converter"
  category="text-tools"
  categoryLabel="Text Tools"
>
  <div>
    <textarea
      id="case-input"
      class="w-full resize-y rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] p-4 text-sm text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-hairline-strong)] placeholder:text-[var(--color-mute)]"
      rows="5"
      placeholder="Type or paste your text here..."
      aria-label="Text input for case conversion"
    ></textarea>

    <!-- Conversion Buttons -->
    <div class="mt-4 flex flex-wrap gap-2">
      <button data-case="upper" class="case-btn rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]">UPPERCASE</button>
      <button data-case="lower" class="case-btn rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]">lowercase</button>
      <button data-case="title" class="case-btn rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]">Title Case</button>
      <button data-case="sentence" class="case-btn rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]">Sentence case</button>
      <button data-case="camel" class="case-btn rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]">camelCase</button>
      <button data-case="pascal" class="case-btn rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]">PascalCase</button>
      <button data-case="snake" class="case-btn rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]">snake_case</button>
      <button data-case="kebab" class="case-btn rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]">kebab-case</button>
      <button data-case="toggle" class="case-btn rounded-full border border-[var(--color-hairline)] px-4 py-2 text-xs font-medium text-[var(--color-body)] transition-colors hover:bg-[var(--color-canvas-soft-2)]">tOGGLE cASE</button>
    </div>

    <!-- Output -->
    <div class="mt-6">
      <label class="mb-2 block text-xs font-medium text-[var(--color-mute)]">Result</label>
      <textarea
        id="case-output"
        class="w-full resize-y rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] p-4 text-sm text-[var(--color-ink)] outline-none"
        rows="5"
        readonly
        aria-label="Converted text output"
      ></textarea>
      <button id="case-copy" class="mt-3 rounded-full bg-[var(--color-primary)] px-4 py-2 text-sm font-medium text-[var(--color-on-primary)] transition-opacity hover:opacity-90">
        Copy Result
      </button>
    </div>
  </div>
  <Fragment slot="faq">
    <FAQ faqs={faqs} title="Case Converter FAQ" />
    <FAQSchema faqs={faqs} />
  </Fragment>
</ToolLayout>

<script>
  const input = document.getElementById('case-input') as HTMLTextAreaElement;
  const output = document.getElementById('case-output') as HTMLTextAreaElement;
  const copyBtn = document.getElementById('case-copy');
  const buttons = document.querySelectorAll('.case-btn');

  function toTitleCase(str: string) {
    return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
  }

  function toSentenceCase(str: string) {
    return str.toLowerCase().replace(/(^\s*\w|[.!?]\s*\w)/g, (c) => c.toUpperCase());
  }

  function toCamelCase(str: string) {
    return str.toLowerCase().replace(/[^a-zA-Z0-9]+(.)/g, (_, c) => c.toUpperCase());
  }

  function toPascalCase(str: string) {
    const camel = toCamelCase(str);
    return camel.charAt(0).toUpperCase() + camel.slice(1);
  }

  function toSnakeCase(str: string) {
    return str.toLowerCase().replace(/[^a-zA-Z0-9]+/g, '_').replace(/^_|_$/g, '');
  }

  function toKebabCase(str: string) {
    return str.toLowerCase().replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-|-$/g, '');
  }

  function toToggleCase(str: string) {
    return str.split('').map((c) => c === c.toUpperCase() ? c.toLowerCase() : c.toUpperCase()).join('');
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = input.value;
      const caseType = (btn as HTMLElement).dataset.case;

      switch (caseType) {
        case 'upper': output.value = text.toUpperCase(); break;
        case 'lower': output.value = text.toLowerCase(); break;
        case 'title': output.value = toTitleCase(text); break;
        case 'sentence': output.value = toSentenceCase(text); break;
        case 'camel': output.value = toCamelCase(text); break;
        case 'pascal': output.value = toPascalCase(text); break;
        case 'snake': output.value = toSnakeCase(text); break;
        case 'kebab': output.value = toKebabCase(text); break;
        case 'toggle': output.value = toToggleCase(text); break;
      }
    });
  });

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(output.value);
    copyBtn.textContent = 'Copied!';
    setTimeout(() => (copyBtn.textContent = 'Copy Result'), 1500);
  });
</script>
