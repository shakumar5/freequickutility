---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
---

<BaseLayout title="Contact - FreeQuickUtility" description="Get in touch with us. Suggest a new tool, report a bug, or share feedback.">
  <Fragment slot="head">
    <SEO title="Contact Us - FreeQuickUtility" description="Have a question, suggestion, or bug report? We'd love to hear from you." canonical="/contact" />
  </Fragment>

  <div class="mx-auto max-w-2xl px-4 py-12 md:px-6 md:py-20">
    <h1 class="text-3xl font-semibold tracking-tight text-[var(--color-ink)] md:text-4xl" style="letter-spacing: -1.28px;">Get in touch.</h1>
    <p class="mt-3 text-base text-[var(--color-body)]">Have feedback, a tool suggestion, or found a bug? We'd love to hear from you.</p>

    <!-- Success message -->
    <div id="success-msg" class="mt-6 hidden rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800">
      ✓ Message sent successfully! We'll get back to you soon.
    </div>

    <form class="mt-8 space-y-4" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="f0c4b648-0850-4efa-898e-c711b8d42a37" />
      <input type="hidden" name="from_name" value="FreeQuickUtility Contact Form" />
      <input type="hidden" name="to" value="kausshailesh@gmail.com" />
      <input type="hidden" name="redirect" value="https://freequickutility.com/contact?success=true" />
      <!-- Honeypot spam protection -->
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
      <div>
        <label for="contact-name" class="mb-1.5 block text-xs font-medium text-[var(--color-body)]">Name <span class="text-[var(--color-error)]">*</span></label>
        <input type="text" id="contact-name" name="name" required placeholder="Your name" class="w-full rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] px-4 py-2.5 text-sm text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-hairline-strong)]" />
      </div>
      <div>
        <label for="contact-email" class="mb-1.5 block text-xs font-medium text-[var(--color-body)]">Email <span class="text-[var(--color-error)]">*</span></label>
        <input type="email" id="contact-email" name="email" required placeholder="you@example.com" class="w-full rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] px-4 py-2.5 text-sm text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-hairline-strong)]" />
      </div>
      <div>
        <label for="contact-subject" class="mb-1.5 block text-xs font-medium text-[var(--color-body)]">Subject <span class="text-[var(--color-error)]">*</span></label>
        <select id="contact-subject" name="subject" required class="w-full rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] px-4 py-2.5 text-sm text-[var(--color-ink)] outline-none">
          <option value="" disabled selected>Select a topic</option>
          <option value="Tool Suggestion">Tool Suggestion</option>
          <option value="Bug Report">Bug Report</option>
          <option value="Feedback">Feedback</option>
          <option value="Partnership">Partnership</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <div>
        <label for="contact-message" class="mb-1.5 block text-xs font-medium text-[var(--color-body)]">Message <span class="text-[var(--color-error)]">*</span></label>
        <textarea id="contact-message" name="message" rows="5" required placeholder="Tell us what's on your mind..." class="w-full resize-y rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] px-4 py-2.5 text-sm text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-hairline-strong)]"></textarea>
      </div>
      <button type="submit" class="rounded-full bg-[var(--color-primary)] px-6 py-2.5 text-sm font-medium text-[var(--color-on-primary)] transition-opacity hover:opacity-90">
        Send Message
      </button>
    </form>
  </div>
</BaseLayout>

<script>
  // Show success message if redirected back after form submission
  if (window.location.search.includes('success=true')) {
    const msg = document.getElementById('success-msg');
    if (msg) msg.classList.remove('hidden');
  }
</script>
